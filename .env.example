# ====================================================
# Photobooth Web Server - Environment Configuration
# ====================================================

ENV=production
DEBUG=False
DOMAIN=booth.tenclb.vn
BASE_URL=https://booth.tenclb.vn
MEDIA_BASE_URL=https://booth.tenclb.vn

# Database
POSTGRES_USER=photobooth
POSTGRES_PASSWORD=generate_a_super_strong_password_here_2026
POSTGRES_DB=photobooth
DATABASE_URL=postgresql://photobooth:generate_a_super_strong_password_here_2026@db:5432/photobooth

# Cryptographic Keys (Section 15)
# 32-byte hex string for AES-256-GCM column encryption
AES_MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Secret pepper key for HMAC hashing (OTP, searchable phone index)
HMAC_PEPPER_KEY=change_me_to_a_random_secret_pepper_string_2026

# Secret key for JWT signing
JWT_SECRET=change_me_to_a_high_entropy_jwt_secret_key_2026

# SePay Payment Gateway Integration (Section 7)
SEPAY_API_KEY=sepay_api_secret_key_from_dashboard
BANK_NAME=BIDV
BANK_BIN=970418
ACCOUNT_NUMBER=5602000743
ACCOUNT_NAME=CHỦ TÀI KHOẢN

# Storage Directory
STORAGE_DIR=/app/storage
